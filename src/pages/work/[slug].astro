---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  // Every project on the homepage needs a page, and every page a project.
  const slugs = new Set(projects.map((p) => p.slug));
  for (const e of entries) {
    if (!slugs.has(e.id)) throw new Error(`src/content/work/${e.id}.md has no project in projects.ts`);
    slugs.delete(e.id);
  }
  if (slugs.size) throw new Error(`No page in src/content/work/ for: ${[...slugs].join(', ')}`);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { facts, links, waiting } = entry.data;

// The order and the "Next project" row follow the work index.
const index = projects.findIndex((p) => p.slug === entry.id);
const project = projects[index];
const next = projects[(index + 1) % projects.length];
const count = (n: number) => String(n).padStart(2, '0');

// A video's poster goes through the image pipeline like any other image.
const poster =
  project.video && project.shot
    ? await getImage({ src: project.shot.src, width: 1440, format: 'webp' })
    : undefined;
---

<Base title={`${entry.data.title}: David Wurgler`} description={entry.data.lede}>
  <SiteHeader section="work" />
  <main id="main" class="project">
    <article class="wrap">
      <div class="top">
        <a class="btn" href="/#work">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 8H3M7 4L3 8l4 4"></path></svg>
          All work
        </a>
        <span class="label muted">{count(index + 1)} of {count(projects.length)}</span>
      </div>

      <header class="head">
        <h1 class="headline title">{entry.data.title}</h1>
        <p class="lede">{entry.data.lede}</p>
      </header>

      <div class="shot">
        {
          project.video && poster ? (
            <video
              src={project.video.src}
              poster={poster.src}
              width={project.shot!.src.width}
              height={project.shot!.src.height}
              aria-label={project.video.label}
              controls
              muted
              loop
              playsinline
              preload="none"
            />
          ) : project.shot ? (
            <Image
              src={project.shot.src}
              alt={project.shot.alt}
              widths={[720, 1080, 1440, 2160].filter((w) => w <= project.shot!.src.width * 1.5)}
              sizes="(max-width: 760px) calc(100vw - 32px), min(100vw - 80px, 1360px)"
              loading="eager"
            />
          ) : (
            <div class="placeholder label">[Placeholder for David: {project.placeholder}]</div>
          )
        }
      </div>

      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt class="label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="body">
        <div class="text"><Content /></div>
        {
          links.length > 0 && (
            <ul class="links">
              {links.map((l) => (
                <li>
                  <a class="btn" href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {waiting.map((w) => <div class="placeholder extra label">[Placeholder for David: {w}]</div>)}

      <a class="next" href={`/work/${next.slug}`}>
        <span class="headline name">{next.name}</span>
        <span class="label">Next project</span>
      </a>
    </article>
  </main>
</Base>

<style>
  .project {
    padding: 132px 40px 64px;
  }

  .wrap {
    display: flex;
    flex-direction: column;
    gap: 56px;
    max-width: 1360px;
    margin: 0 auto;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .muted {
    color: var(--fg-muted);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px 64px;
  }

  .title {
    font-size: clamp(64px, 10vw, 168px);
  }

  .lede {
    max-width: 480px;
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    color: var(--body);
  }

  /* The main image: a print on the paper. A real screenshot keeps its own
     shape, so nothing is cropped; a placeholder takes the mockup's frame. */
  .shot {
    overflow: hidden;
    border-radius: 6px;
    background: var(--night);
  }

  .shot > :global(img),
  .shot > video {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot > .placeholder {
    aspect-ratio: 16 / 10.5;
  }

  /* Marked spaces for images David hasn't supplied yet. The rule keeps them
     visible on the dark theme's ground too. */
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--night);
    color: var(--bone);
    text-align: center;
  }

  .extra {
    min-height: 160px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    margin: 0;
  }

  .facts div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-strong);
  }

  .facts dt {
    color: var(--fg-muted);
  }

  .facts dd {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .body {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px 64px;
  }

  .text {
    flex: 1 1 480px;
    min-width: 0;
    max-width: 680px;
  }

  .text :global(p) {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--body);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The large row at the bottom, in the same shape as a work index row. */
  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 32px;
    margin-top: 40px;
    padding: 18px 0 14px;
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .next .name {
    display: inline-block;
    font-size: clamp(44px, 6.6vw, 104px);
    transition: transform 250ms var(--ease-out);
  }

  .next:hover {
    color: var(--fg);
  }

  .next:hover .name {
    transform: translateX(12px);
  }

  .next:focus-visible {
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .project {
      padding: 104px 20px 48px;
    }

    .wrap {
      gap: 40px;
    }

    .lede {
      font-size: 18px;
    }

    .text :global(p) {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next .name {
      transition: none;
    }
  }
</style>
