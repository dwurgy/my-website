---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  // Every project on the homepage needs a page, and every page a project.
  const slugs = new Set(projects.map((p) => p.slug));
  for (const e of entries) {
    if (!slugs.has(e.id)) throw new Error(`src/content/work/${e.id}.md has no project in projects.ts`);
    slugs.delete(e.id);
  }
  if (slugs.size) throw new Error(`No page in src/content/work/ for: ${[...slugs].join(', ')}`);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const project = projects.find((p) => p.slug === entry.id)!;
const { facts, links, waiting } = entry.data;
// A video's poster goes through the image pipeline like any other image.
const poster =
  project.video && project.shot
    ? await getImage({ src: project.shot.src, width: 1440, format: 'webp' })
    : undefined;
---

<Base title={`${entry.data.title}: David Wurgler`} description={entry.data.lede}>
  <main id="main" class="project">
    <a class="btn back" href="/#work">Back to work</a>
    <h1 class="headline title">{entry.data.title}</h1>
    <p class="lede">{entry.data.lede}</p>
    {
      project.video && poster ? (
        <video
          class="main-shot"
          src={project.video.src}
          poster={poster.src}
          width={project.shot!.src.width}
          height={project.shot!.src.height}
          aria-label={project.video.label}
          controls
          muted
          loop
          playsinline
          preload="none"
        />
      ) : project.shot ? (
        <Image
          class="main-shot"
          src={project.shot.src}
          alt={project.shot.alt}
          widths={[720, 1080, 1440, 2160]}
          sizes="(max-width: 760px) calc(100vw - 32px), min(100vw - 56px, 1360px)"
          loading="eager"
        />
      ) : (
        <div class="main-shot placeholder label">[Placeholder for David: {project.placeholder}]</div>
      )
    }
    <dl class="facts">
      {
        facts.map((f) => (
          <div>
            <dt class="label">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="body"><Content /></div>
    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l) => (
            <li>
              <a class="btn" href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )
    }
    {
      waiting.map((w) => <div class="extra placeholder label">[Placeholder for David: {w}]</div>)
    }
  </main>
</Base>

<style>
  /* A plain first pass. The full v5 layout comes in a later step. */
  .project {
    max-width: 1360px;
    margin: 0 auto;
    padding: 40px var(--gutter) 120px;
  }
  .back {
    margin-bottom: clamp(48px, 10vw, 120px);
  }
  .title {
    font-size: clamp(56px, 10vw, 160px);
  }
  .lede {
    max-width: 32ch;
    margin-top: 28px;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.35;
    color: var(--body);
  }
  .main-shot {
    display: block;
    width: 100%;
    height: auto;
    margin-top: clamp(40px, 6vw, 72px);
    border-radius: 6px;
    background: var(--night);
  }
  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    background: var(--night);
    color: var(--bone);
    text-align: center;
  }
  .extra {
    aspect-ratio: auto;
    min-height: 160px;
    margin-top: 48px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 32px;
    margin: 56px 0 0;
  }
  .facts div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--rule-strong);
  }
  .facts dt {
    color: var(--fg-muted);
  }
  .facts dd {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .body {
    max-width: 60ch;
    margin-top: 56px;
    color: var(--body);
    font-size: 19px;
    line-height: 1.6;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
