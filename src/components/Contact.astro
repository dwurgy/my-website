---
import { Picture } from 'astro:assets';
import reeds from '../../assets/photos/lake-dusk-reeds.jpg';

// The lake starts as a centred print on the paper and, matched to scroll,
// grows to full-bleed by the bottom of the page. The contact text sits on
// the photo and is clipped to the photo's exact shape, so it appears as the
// photo grows. A second "Say hi." in ink waits on the paper below the print
// and is covered as the photo reaches it. Only the copy on the photo is
// read out and interactive.
const email = 'hello@davidwurgler.com';
const links = [
  { href: 'https://www.linkedin.com/in/david-joel-wurgler', label: 'LinkedIn' },
  { href: 'https://github.com/dwurgy', label: 'GitHub' },
];
---

<footer id="hello" class="hello" aria-labelledby="hello-title">
  <div class="stick">
    <p class="headline title on-paper" aria-hidden="true">Say <span class="emphasis">hi.</span></p>

    <div class="window">
      <Picture
        class="photo"
        src={reeds}
        alt="A lake at dusk through the reeds."
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
      />
      <div class="scrim" aria-hidden="true"></div>
    </div>

    <div class="window contact" data-contact>
      <div class="inner">
        <h2 id="hello-title" class="headline title">Say <span class="emphasis">hi.</span></h2>
        <div class="reach">
          <div class="group">
            <a class="pill email" href={`mailto:${email}`}>{email}</a>
            <button class="pill" type="button" data-copy={email}>Copy</button>
            <span class="visually-hidden" role="status" data-copy-status></span>
          </div>
          <div class="group">
            {links.map((link) => <a class="pill" href={link.href}>{link.label}</a>)}
          </div>
        </div>
        <div class="credits">
          <span class="label">Photographed and built by David Wurgler</span>
          <span class="label">Built with Claude Code</span>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { onFrame, progress, reducedMotion, smooth } from '../scripts/scroll';

  const hello = document.querySelector<HTMLElement>('.hello')!;
  const stick = hello.querySelector<HTMLElement>('.stick')!;
  const inkTitle = hello.querySelector<HTMLElement>('.on-paper')!;


  // Scroll sets --print, from 1 (a centred print) to 0 (full-bleed), which
  // the CSS turns into the photo's shape and zoom. It also sets --title, so
  // "Say hi." on the photo stays hidden until the photo has covered the ink
  // "Say hi." below it, then fades in as the photo keeps growing. Only one
  // is ever on screen.
  onFrame(() => {
    if (reducedMotion.matches) {
      return () => {
        hello.style.removeProperty('--print');
        hello.style.removeProperty('--title');
      };
    }
    const print = 1 - smooth(progress(hello));
    // The print value at which the photo has grown past the ink title's
    // bottom and left edges, so the ink title is fully covered. The insets
    // are the fractions set in the CSS (--inset-y, --inset-x).
    const css = getComputedStyle(hello);
    const insetY = parseFloat(css.getPropertyValue('--inset-y')) / 100;
    const insetX = parseFloat(css.getPropertyValue('--inset-x')) / 100;
    const width = stick.clientWidth;
    const height = stick.clientHeight;
    const below = height - (inkTitle.offsetTop + inkTitle.offsetHeight);
    const covered = Math.min(below / (insetY * height), inkTitle.offsetLeft / (insetX * width));
    const title = Math.min(1, Math.max(0, (covered - print) / (0.5 * covered)));
    return () => {
      hello.style.setProperty('--print', print.toFixed(4));
      hello.style.setProperty('--title', title.toFixed(3));
    };
  });

  // The contact links only show once the photo is full-bleed, so tabbing
  // into them jumps to the bottom of the page first.
  hello.querySelector('[data-contact]')!.addEventListener('focusin', () => {
    if (!reducedMotion.matches && progress(hello) < 1) hello.scrollIntoView();
  });

  for (const button of hello.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.parentElement?.querySelector('[data-copy-status]');
    let reset: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied.';
      } catch {
        // No clipboard access: select the address so it can be copied by hand.
        const address = button.parentElement?.querySelector('.email');
        if (address) window.getSelection()?.selectAllChildren(address);
        if (status) status.textContent = 'Email address selected.';
      }
      clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .hello {
    --print: 1;
    --inset-x: 30%;
    --inset-y: 22%;
    --edge: 40px;
    height: 210vh;
    /* Links to #hello land at the end of the pin, where the photo is
       full-bleed and the contact links show. 210vh - 100vh of travel. */
    scroll-margin-top: -110vh;
  }

  .stick {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .window {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(
      calc(var(--print) * var(--inset-y)) calc(var(--print) * var(--inset-x))
        round calc(var(--print) * var(--radius-print))
    );
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1 + 0.1 * var(--print)));
  }

  .scrim {
    position: absolute;
    inset: auto 0 0;
    height: 65%;
    background: linear-gradient(180deg, rgb(20 16 14 / 0) 0%, rgb(20 16 14 / 0.58) 100%);
  }

  .title {
    font-size: clamp(64px, 10vw, 160px);
    letter-spacing: -0.04em;
    text-wrap: wrap;
  }

  .on-paper {
    position: absolute;
    left: var(--edge);
    right: var(--edge);
    bottom: var(--edge);
    color: var(--fg);
  }

  /* Text on the photo is the same in both themes. */
  .contact {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 var(--edge) var(--edge);
    color: var(--bone);
  }

  .contact .title {
    color: var(--bone-bright);
    opacity: var(--title, 1);
  }

  .contact :focus-visible {
    outline-color: var(--bone-bright);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .reach {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .email {
    padding: 0 24px;
    font-family: var(--font-mono);
    font-size: 15px;
    user-select: all;
  }

  .credits {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.3);
  }

  @media (max-width: 760px) {
    .hello {
      --inset-x: 8%;
      --edge: 20px;
    }

    .email {
      padding: 0 18px;
      font-size: 13px;
    }
  }

  /* Reduced motion: the lake is already full-bleed, and the section is one
     screen tall, so there is no still stretch to scroll through. */
  @media (prefers-reduced-motion: reduce) {
    .hello {
      --print: 0;
      height: auto;
      scroll-margin-top: 0;
    }
  }
</style>
