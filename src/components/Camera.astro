---
import { Image, getImage } from 'astro:assets';
import { photos } from '../data/photos';

// A camera, modelled in 3D (three.js, in src/scripts/camera-3d.ts), whose rear
// screen shows David's photographs. The dial's left and right sides flip
// through them. Its pose comes from progress, 0 (turned, screen tilted out)
// to 1 (straight-on back, screen flush), which the page sets from scroll (or
// the test page's slider) through setPose().
//
// The dial's two halves are real buttons laid over the drawing; hovering one
// lights its arrow. Under the camera, a small count ("01 / 07") between two
// more arrow buttons says there's more than one photo and works on any
// screen. If the browser can't draw 3D, the photos show as a plain print with
// the count below it.

const pad = (n: number) => String(n).padStart(2, '0');

// Two sizes of each photo for the screen; the script picks by screen size.
const textures = await Promise.all(
  photos.map(async (photo) => {
    const [small, large] = await Promise.all([
      getImage({ src: photo.src, width: 800, format: 'webp' }),
      getImage({ src: photo.src, width: 1400, format: 'webp' }),
    ]);
    return { small: small.src, large: large.src, alt: photo.alt };
  }),
);
---

<div class="viewer" data-camera data-photos={JSON.stringify(textures)}>
  <div
    class="stage"
    tabindex="0"
    role="group"
    aria-roledescription="photo viewer"
    aria-label="Photographs. Use the left and right arrow keys, or the dial, to flip through them."
  >
    <div class="scene" data-scene>
      <canvas class="gl" data-gl role="img" aria-label={photos[0].alt}></canvas>

      <!-- Only shown when 3D isn't available. -->
      <div class="flat" data-flat>
        {
          photos.map((photo, i) => (
            <Image
              class:list={['shot', { 'is-on': i === 0 }]}
              src={photo.src}
              alt=""
              data-alt={photo.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 760px) 88vw, 720px"
              loading="lazy"
            />
          ))
        }
      </div>

      <button type="button" class="dial-key prev" aria-label="Previous photo" data-step="-1"></button>
      <button type="button" class="dial-key next" aria-label="Next photo" data-step="1"></button>
    </div>
  </div>

  <div class="count">
    <button type="button" class="count-key" aria-label="Previous photo" data-step="-1">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5"></path></svg>
    </button>
    <p class="label count-text">
      <span data-index>01</span> / {pad(photos.length)}
    </p>
    <button type="button" class="count-key" aria-label="Next photo" data-step="1">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5"></path></svg>
    </button>
  </div>

  <p class="visually-hidden" aria-live="polite" data-live></p>
</div>

<style>
  .viewer {
    position: relative;
    overflow: clip;
    display: grid;
    place-items: center;
    gap: 8px;
  }

  .stage {
    /* As large as fits: wide on a laptop, but never taller than the screen. */
    width: min(1000px, 94vw, calc((100svh - 120px) * 1.5));
    border-radius: 12px;
    outline-offset: 8px;
  }

  .stage:focus-visible {
    outline: 2px solid var(--fg);
  }

  .scene {
    position: relative;
    aspect-ratio: 3 / 2;
    /* A sideways swipe flips the photo; vertical scrolling still works. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* The dial's halves. The script places them over the drawn dial. */
  .dial-key {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .dial-key:focus-visible {
    outline: 2px solid var(--bone-bright);
    outline-offset: 0;
  }

  /* The count under the camera, between its two arrows. */
  .count {
    /* Up into the empty space the canvas keeps below the camera for its turn. */
    margin-top: max(-56px, -6vw);
    /* Above the canvas, which would otherwise catch its clicks. */
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--fg-muted);
  }

  .count-text {
    margin: 0;
    min-width: 7ch;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .count-key {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .count-key:hover {
    color: var(--fg);
  }

  .count-key:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: -4px;
  }

  .count-key svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* If the browser can't draw 3D: the photo as a print, the count below. */
  .flat {
    display: none;
  }

  .viewer.is-flat .gl {
    display: none;
  }

  .viewer.is-flat .flat {
    display: block;
    position: absolute;
    inset: 4% 10%;
    overflow: hidden;
    border-radius: var(--radius-print);
  }

  .viewer.is-flat .dial-key {
    display: none;
  }

  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 250ms ease;
  }

  .shot.is-on {
    z-index: 2;
    opacity: 1;
  }

  .shot.was {
    z-index: 1;
    opacity: 1;
    transition: none;
  }
</style>

<script>
  import { setupCamera } from '../scripts/camera';

  for (const root of document.querySelectorAll<HTMLElement>('[data-camera]')) setupCamera(root);
</script>
