---
import { artistUrl, songIds } from '../data/tracks';

// A compact digital music player, modelled in 3D (src/scripts/player-3d.ts)
// with the camera's light and materials, that plays a few My Brothers And I
// songs through Apple Music (src/scripts/player.ts). Drag it to turn it; drag
// the knob on top to change songs; press its button to play or pause. The
// same controls are real buttons under it, for keyboards, screen readers, and
// browsers that can't draw 3D. The songs are chosen in src/data/tracks.ts.
---

<div class="player" data-player data-songs={JSON.stringify(songIds)} data-artist-url={artistUrl}>
  <div
    class="stage"
    tabindex="0"
    role="group"
    aria-roledescription="music player"
    aria-label="Music player. Space plays or pauses, and the left and right arrow keys change the song."
  >
    <div class="scene" data-scene>
      <canvas class="gl" data-gl role="img" aria-label="A music player."></canvas>
      <!-- Only shown when 3D isn't available. -->
      <div class="flat">
        <img data-flat-art alt="" hidden width="1000" height="1000" decoding="async" />
      </div>
    </div>
  </div>

  <div class="deck">
    <button type="button" class="key" data-step="-1" aria-label="Previous song">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3v10M12 3 6 8l6 5"></path></svg>
    </button>
    <button type="button" class="key" data-play data-state="paused" aria-label="Play">
      <svg class="when-paused" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10l8-5z"></path></svg>
      <svg class="when-playing" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10"></path></svg>
    </button>
    <button type="button" class="key" data-step="1" aria-label="Next song">
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M12 3v10M4 3l6 5-6 5"></path></svg>
    </button>
  </div>

  <p class="label readout" data-readout aria-hidden="true"></p>
  <p class="title" data-title></p>

  <p class="links">
    <a class="textlink" data-listen href={artistUrl}>Listen on Apple Music</a>
    <button type="button" class="textlink" data-sign-in hidden>Sign in with Apple Music for full songs</button>
  </p>
  <p class="note" data-note hidden></p>

  <p class="visually-hidden" aria-live="polite" data-live></p>
</div>

<style>
  .player {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .stage {
    width: min(560px, 90vw, calc(100svh - 180px));
    border-radius: 12px;
    outline-offset: 8px;
  }

  .stage:focus-visible {
    outline: 2px solid var(--fg);
  }

  .scene {
    position: relative;
    aspect-ratio: 1;
    /* A sideways drag turns the player; vertical scrolling still works. */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    cursor: grab;
  }

  .gl {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* If the browser can't draw 3D: the song's artwork as a print. */
  .flat {
    display: none;
  }

  .player:global(.is-flat) .gl {
    display: none;
  }

  .player:global(.is-flat) .scene {
    cursor: auto;
  }

  .player:global(.is-flat) .flat {
    display: flex;
    justify-content: center;
    position: absolute;
    inset: 8% 0;
  }

  .flat img {
    height: 100%;
    width: auto;
    max-width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-print);
  }

  /* The buttons under the player, in the style of the camera's count. */
  .deck {
    /* Up into the empty space the canvas keeps below the player. */
    margin-top: max(-28px, -4vw);
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--fg-muted);
  }

  .key {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .key:hover:not(:disabled) {
    color: var(--fg);
  }

  .key:disabled {
    cursor: default;
    opacity: 0.5;
  }

  .key:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: -4px;
  }

  .key svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  [data-play] .when-paused path {
    fill: currentColor;
  }

  [data-play][data-state='paused'] .when-playing,
  [data-play][data-state='playing'] .when-paused {
    display: none;
  }

  .readout {
    margin: 0;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .title {
    margin: 0;
    min-height: 1.5em;
    font-size: 15px;
    color: var(--body);
    text-align: center;
  }

  .links {
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 24px;
  }

  /* Plain, quiet text links. */
  .textlink {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .textlink:hover {
    color: var(--fg);
  }

  .textlink:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .textlink[hidden] {
    display: none;
  }

  .note {
    margin: 0;
    font-size: 14px;
    color: var(--fg-muted);
  }
</style>

<script>
  import { setupPlayer } from '../scripts/player';

  for (const root of document.querySelectorAll<HTMLElement>('[data-player]')) setupPlayer(root);
</script>
