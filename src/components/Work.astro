---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="head">
      <h2 id="work-title" class="label">Selected work</h2>
      <span class="label years">2025–2026</span>
    </div>

    <ul class="list" role="list" data-work-list>
      {
        projects.map((project) => (
          <li>
            <a class="row" href={`/work/${project.slug}`} data-slug={project.slug}>
              <span class="headline">
                <span class="name">{project.name}</span>
              </span>
              <span class="line">{project.line}</span>
              <span class="label meta">{project.meta}</span>
            </a>
            {project.shot && (
              <Image
                class="touch-shot"
                src={project.shot.src}
                alt={project.shot.alt}
                widths={[390, 780, 1170].filter((w) => w <= project.shot!.src.width)}
                sizes="(max-width: 760px) calc(100vw - 40px), min(100vw - 80px, 1360px)"
              />
            )}
          </li>
        ))
      }
    </ul>

    <p class="also">
      Also: I moved a company off QuickBooks Desktop and onto Odoo 19 in ten weeks, with zero
      downtime.
    </p>
  </div>

  <!-- The preview that follows the cursor. It repeats what the row says, so
       it's hidden from screen readers. It stays unrendered until the section
       is near, so its images don't load with the top of the page. -->
  <div class="preview" aria-hidden="true" data-preview>
    {
      projects.map((project) =>
        project.shot ? (
          <Image
            class="shot"
            src={project.shot.src}
            alt=""
            widths={[360, 720]}
            sizes="360px"
            data-slug={project.slug}
          />
        ) : (
          <div class="shot placeholder label" data-slug={project.slug}>
            [{project.placeholder}]
          </div>
        ),
      )
    }
  </div>
</section>

<script>
  import { onFrame, requestFrame, reducedMotion } from '../scripts/scroll';

  const work = document.querySelector<HTMLElement>('#work')!;
  const list = work.querySelector<HTMLElement>('[data-work-list]')!;
  const preview = work.querySelector<HTMLElement>('[data-preview]')!;
  const rows = [...list.querySelectorAll<HTMLElement>('.row')];
  const shots = [...preview.querySelectorAll<HTMLElement>('[data-slug]')];

  const WIDTH = 360;
  const HALF_HEIGHT = 118;
  const LAG = 0.22;

  let active: HTMLElement | null = null;
  let byKeyboard = false;
  let mouseX = 0;
  let mouseY = 0;
  let x: number | null = null;
  let y = 0;

  // Render the preview (and so load its images) once the section is near.
  new IntersectionObserver(
    (entries, observer) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        preview.dataset.ready = '';
        observer.disconnect();
      }
    },
    { rootMargin: '800px 0px' },
  ).observe(work);

  function show(row: HTMLElement | null, keyboard = false) {
    if (row === active && keyboard === byKeyboard) return;
    if (row !== active || !row) x = null;
    active = row;
    byKeyboard = keyboard;
    list.toggleAttribute('data-hovering', !!row);
    rows.forEach((r) => r.toggleAttribute('data-on', r === row));
    shots.forEach((s) => s.toggleAttribute('data-on', !!row && s.dataset.slug === row.dataset.slug));
    preview.toggleAttribute('data-on', !!row);
    requestFrame();
  }

  for (const row of rows) {
    row.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      mouseX = event.clientX;
      mouseY = event.clientY;
      show(row);
    });
    // Only keyboard focus shows the preview; a click is about to leave the page.
    row.addEventListener('focus', () => {
      if (row.matches(':focus-visible')) show(row, true);
    });
    row.addEventListener('blur', () => {
      if (row === active && byKeyboard) show(null);
    });
  }

  list.addEventListener('pointerleave', () => {
    if (!byKeyboard) show(null);
  });

  addEventListener(
    'pointermove',
    (event) => {
      if (event.pointerType !== 'mouse') return;
      mouseX = event.clientX;
      mouseY = event.clientY;
      if (active && !byKeyboard) requestFrame();
    },
    { passive: true },
  );

  // Opening a project: whatever image stands for it on screen (the preview,
  // or on touch screens the image under its name) becomes the project page's
  // main image during the page transition.
  addEventListener('pageswap', (event) => {
    const url = event.activation?.entry?.url;
    if (!event.viewTransition || !url) return;
    const slug = new URL(url).pathname.match(/^\/work\/([^/]+)\/?$/)?.[1];
    if (!slug) return;
    const row = rows.find((r) => r.dataset.slug === slug);
    const shown = preview.matches('[data-on]')
      ? preview
      : row?.parentElement?.querySelector<HTMLElement>('.touch-shot');
    if (!shown || !shown.checkVisibility()) return;
    shown.style.viewTransitionName = 'project-shot';
  });

  // Coming back (including from the back/forward cache): start clean.
  addEventListener('pageshow', () => {
    preview.style.viewTransitionName = '';
    list.querySelectorAll<HTMLElement>('.touch-shot').forEach((s) => (s.style.viewTransitionName = ''));
    show(null);
  });

  // The preview eases toward the cursor (or beside the focused row) with a
  // slight lag, inside the page's one animation loop.
  onFrame(() => {
    if (!active) return;
    let targetX: number;
    let targetY: number;
    if (byKeyboard) {
      const box = active.getBoundingClientRect();
      targetX = Math.max(16, box.right - WIDTH - 28);
      targetY = box.top + box.height / 2 - HALF_HEIGHT;
    } else {
      targetX = mouseX + 32;
      targetY = mouseY - HALF_HEIGHT;
      if (targetX + WIDTH > innerWidth - 16) targetX = mouseX - WIDTH - 32;
    }
    if (x === null || reducedMotion.matches) {
      x = targetX;
      y = targetY;
    }
    x += (targetX - x) * LAG;
    y += (targetY - y) * LAG;
    const settled = Math.abs(targetX - x) < 0.5 && Math.abs(targetY - y) < 0.5;
    const left = x;
    const top = y;
    return () => {
      preview.style.transform = `translate3d(${left}px, ${top}px, 0)`;
      if (!settled) requestFrame();
    };
  });
</script>

<style>
  .work {
    padding: 180px 40px 200px;
  }

  .wrap {
    max-width: 1360px;
    margin: 0 auto;
  }

  .head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
  }

  .head h2 {
    margin: 0;
    font-weight: 400;
  }

  .years {
    color: var(--fg-muted);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .also {
    max-width: 560px;
    margin: 20px 0 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 320px) 120px;
    align-items: baseline;
    gap: 32px;
    padding: 18px 0 14px;
    border-top: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
    transition: opacity 200ms ease;
  }

  .row:focus-visible {
    border-radius: 4px;
  }

  .name {
    display: inline-block;
    font-size: clamp(44px, 6.6vw, 104px);
    transition: transform 250ms var(--ease-out);
  }

  .line {
    font-size: 15px;
    line-height: 1.5;
    color: var(--fg-muted);
  }

  .meta {
    text-align: right;
    white-space: nowrap;
  }

  /* Hovering or focusing one row quiets the others. */
  .list[data-hovering] .row {
    opacity: 0.32;
  }

  .list[data-hovering] .row[data-on] {
    opacity: 1;
  }

  .row[data-on] .name {
    transform: translateX(12px);
  }

  .touch-shot {
    display: none;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10.5;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-print);
    background: var(--night);
    margin: 4px 0 24px;
  }

  .preview {
    display: none;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 20;
    width: 360px;
    height: 236px;
    overflow: hidden;
    border-radius: var(--radius-print);
    background: var(--night);
    box-shadow: 0 24px 60px rgba(27, 24, 21, 0.28);
    pointer-events: none;
    opacity: 0;
    scale: 0.94;
    transition:
      opacity 200ms ease,
      scale 200ms var(--ease-out);
  }

  .preview[data-ready] {
    display: block;
  }

  .preview[data-on] {
    opacity: 1;
    scale: 1;
  }

  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
  }

  .shot[data-on] {
    opacity: 1;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bone);
  }

  @media (max-width: 760px) {
    .work {
      padding-inline: 20px;
    }

    .row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .line {
      display: none;
    }
  }

  /* Touch screens: no cursor to follow, so each project's image sits under its name. */
  @media (hover: none) {
    .touch-shot {
      display: block;
    }

    .preview,
    .preview[data-ready] {
      display: none;
    }
  }
</style>
