---
// The whole site. Every address renders this same page with a different door
// open, so each one can be linked to and read without scripts. With scripts,
// src/scripts/site.ts moves between doors in place.
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import Reel from './Reel.astro';
import { doors, path } from '../data/doors';
import { things } from '../data/things';
import { photos } from '../data/photos';

interface Props {
  /** Which door is open: '' for the bare sentence, 'things/firn' for Firn, 'lost' for the 404 page. */
  open: string;
}

const { open } = Astro.props;
const lost = open === 'lost';
const meta = doors.find((d) => d.door === open) ?? { title: 'Page not found · David Wurgler', description: 'This page isn’t here.' };
const word = lost ? '' : open.split('/')[0];
const current = (w: string) => (word === w ? 'page' : undefined);
const titleOf = (door: string) => doors.find((d) => d.door === door)!.title;
---

<Base title={meta.title} description={meta.description} path={lost ? '/404' : path(open)} noindex={lost}>
  <body class="arrive" data-open={word || (lost ? 'lost' : undefined)} data-shown={open} data-home-title={titleOf('')}>
    <header class="line">
      <!-- The spaces are written out, because the build strips the ones between tags. -->
      <h1>
        <a href="/i/" data-word="i" aria-current={current('i')}>I</a>{' '}
        <a href="/make/" data-word="make" aria-current={current('make')}>make</a>{' '}
        <a href="/pretty/" data-word="pretty" aria-current={current('pretty')}>pretty</a>{' '}
        <a href="/things/" data-word="things" aria-current={current('things')}>things</a><a
          href="/hi/"
          class="dot"
          data-word="hi"
          aria-label="Say hi"
          aria-current={current('hi')}><span></span></a
        >
      </h1>
    </header>

    <main class="col">
      <section data-door="i" data-title={titleOf('i')} hidden={open !== 'i'}>
        <h2 class="sr">I</h2>
        <p>I’m David Wurgler. I design and build software, and I live in Salem, Oregon, with my wife and our two boys.</p>
        <p>
          I make my apps with Claude, an AI from Anthropic, as my coding partner. I decide what each one is and how it
          should feel: the design, the details, the way it behaves. Claude and I write the code together and catch each
          other’s mistakes.
        </p>
        <p>I build the things I wish already existed: quiet, well-made tools that respect your time and your privacy.</p>
        <p><a href="/hi/">Say hi</a></p>
      </section>

      <section data-door="make" data-title={titleOf('make')} hidden={open !== 'make'}>
        <h2 class="sr">make</h2>
        <p>I don’t write most of the code. I write the brief.</p>
        <p>
          Every project starts with a document: who it’s for, the rules the agent can’t break, and a done test for each
          step. Then I direct Claude Code through it in pieces small enough to check.
        </p>
        <ul class="dim" aria-label="Rules from Firn’s brief">
          <li>Work in small, testable steps.</li>
          <li>No new dependencies without asking.</li>
          <li>Never weaken a security default.</li>
          <li>Each phase ends with a done test.</li>
        </ul>
        <p>
          I care about how it feels, not just how it looks. Good software should be pretty to look at and easy to use.
          Then it should get out of your way.
        </p>
        <p>This site was made the same way. <a href="https://github.com/dwurgy/my-website">Read the source</a></p>
      </section>

      <section data-door="pretty" data-title={titleOf('pretty')} hidden={open !== 'pretty'}>
        <h2 class="sr">pretty</h2>
        <p>I take pictures.</p>
        <Reel shots={photos} lead={open === 'pretty'} />
        <p>I make music.</p>
        <p>
          I sing, write, and produce in a band called <span class="together">My Brothers And I.</span> Our songs have
          been on Virgin River, Pretty Little Liars, Love Island, and others.
        </p>
        <p class="out">
          <a href="https://open.spotify.com/artist/01pbsrLZgBLuMIoU10Ypyb">Spotify</a>
          <a href="https://music.apple.com/us/artist/my-brothers-and-i/892386824">Apple Music</a>
          <a href="https://www.mybrothersandiband.com/">The band</a>
        </p>
      </section>

      <section data-door="things" data-title={titleOf('things')} hidden={open !== 'things'}>
        <h2 class="sr">things</h2>
        <ul class="things">
          {
            things.map((t, i) => (
              <li style={`--i: ${i}`}>
                <a href={path(`things/${t.slug}`)} data-peek={t.slug}>
                  <b>{t.name}</b>
                  <span>{t.line}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="peek" aria-hidden="true">
          {
            things.map((t) => (
              <figure data-peek={t.slug}>
                <figcaption>{t.line}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      {
        things.map((t, i) => {
          const door = `things/${t.slug}`;
          const next = things[(i + 1) % things.length];
          return (
            <section class="thing" data-door={door} data-title={titleOf(door)} hidden={open !== door}>
              <h2>{t.name}</h2>
              <p class="dim">{t.line}</p>
              <Reel shots={t.shots} lead={open === door} />
              {t.body.map((p) => (
                <p>{p}</p>
              ))}
              <dl>
                {t.facts.map(([label, value]) => (
                  <>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </>
                ))}
              </dl>
              {t.links.length > 0 && (
                <p class="out">
                  {t.links.map(([label, href]) => (
                    <a href={href}>{label}</a>
                  ))}
                </p>
              )}
              <p class="next">
                <span class="dim">Next,</span> <a href={path(`things/${next.slug}`)}>{next.name}</a>
              </p>
            </section>
          );
        })
      }

      <section data-door="hi" data-title={titleOf('hi')} hidden={open !== 'hi'}>
        <h2 class="sr">Say hi</h2>
        <p>
          <span id="email">hello@davidwurgler.com</span><button class="copy" type="button" id="copy">Copy</button>
        </p>
        <p class="out">
          <a href="https://www.linkedin.com/in/david-joel-wurgler">LinkedIn</a>
          <a href="https://github.com/dwurgy">GitHub</a>
          <a href="https://www.threads.com/@dwurgy">Threads</a>
        </p>
        <div class="mark"><Mark /></div>
      </section>

      {
        lost && (
          <section data-door="lost">
            <h2 class="sr">Page not found</h2>
            <p>This page isn’t here.</p>
            <p class="dim">The link may be old, or have a typo in it. The sentence still works.</p>
          </section>
        )
      }
    </main>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</Base>
