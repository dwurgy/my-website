---
// The wordmark pill and the nav pill, floating over the hero photo.
// On phones the nav folds into a menu pill that opens it as a popover.
const links = [
  { href: '#work', label: 'Work' },
  { href: '#how', label: 'How I build' },
  { href: '#offclock', label: 'Off the clock' },
];
---

<header class="site-header">
  <a class="skip-link pill" href="#main">Skip to content</a>
  <a class="pill wordmark" href="/" aria-label="David Wurgler, home">WURGLER</a>
  <button class="pill menu-button" type="button" popovertarget="site-nav" aria-controls="site-nav">
    Menu
  </button>
  <nav class="pill nav" id="site-nav" popover aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="nav-cta" href="#hello">Say hi</a>
  </nav>
</header>

<script>
  // Close the phone menu once a link in it is followed.
  const nav = document.getElementById('site-nav');
  nav?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement && nav.matches(':popover-open')) {
      nav.hidePopover();
    }
  });
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 24px var(--gutter) 0;
  }

  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: 24px;
    z-index: 1;
    padding: 12px 20px;
    font-size: 14px;
    background: var(--bone);
    color: var(--ink);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .wordmark {
    padding: 12px 30px;
    font-size: 22px;
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: 0.2em;
  }

  .menu-button {
    display: none;
    padding: 12px 20px;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  /* On wide screens the popover is shown in place as an ordinary pill. */
  .nav {
    position: static;
    inset: auto;
    margin: 0;
    display: flex;
    gap: 0;
    padding: 6px 8px;
    overflow: visible;
  }

  .nav a {
    padding: 10px 14px;
    font-size: 14px;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .nav a:not(.nav-cta):hover {
    background: rgb(255 255 255 / 0.14);
  }

  .nav .nav-cta {
    padding: 10px 18px;
    background: var(--bone);
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .site-header {
      padding-top: 16px;
    }

    .wordmark {
      padding: 11px 22px;
      font-size: 17px;
    }

    .menu-button {
      display: inline-flex;
    }

    .nav:not(:popover-open) {
      display: none;
    }

    .nav:popover-open {
      position: fixed;
      inset: 76px var(--gutter) auto auto;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      min-width: 220px;
      padding: 8px;
      border-radius: var(--radius-card-small);
      background: rgb(40 34 30 / 0.55);
    }

    .nav:popover-open a {
      padding: 14px 18px;
      font-size: 17px;
    }

    .nav::backdrop {
      background: rgb(21 19 17 / 0.35);
    }
  }
</style>
