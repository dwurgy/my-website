---
import Mark from './Mark.astro';

interface Props {
  /** The section a page off the homepage belongs to (a project page is "work"). */
  section?: string;
}
const { section } = Astro.props;
// Off the homepage, the section links go back to the homepage.
const base = Astro.url.pathname === '/' ? '' : '/';

// The control bar: the one glass object on the page, fixed and centred at
// the top. The link for the section in view is at full strength.
const links = [
  { href: '#work', id: 'work', label: 'Work' },
  { href: '#how', id: 'how', label: 'How I build', mid: true },
  { href: '#offclock', id: 'offclock', label: 'Off the clock', mid: true },
];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="bar">
  <a class="wordmark" href="/" aria-label="David Wurgler, home"><Mark class="wordmark-mark" />WURGLER</a>
  <nav aria-label="Main">
    {
      links.map((link) => (
        <a
          class:list={['nav-link', { 'nav-mid': link.mid, 'is-current': link.id === section }]}
          href={base + link.href}
          data-nav={link.id}
        >
          {link.label}
        </a>
      ))
    }
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10.5A6.5 6.5 0 0 1 7.5 3a6.5 6.5 0 1 0 7.5 7.5z"></path></svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="9" cy="9" r="3.2"></circle><path d="M9 1.5v1.8M9 14.7v1.8M1.5 9h1.8M14.7 9h1.8M3.7 3.7l1.3 1.3M13 13l1.3 1.3M3.7 14.3L5 13M13 5l1.3-1.3"></path></svg>
    </button>
    <a class="nav-link say-hi" href={base + '#hello'} data-nav="hello">Say hi</a>
  </nav>
</header>

<script>
  import { onFrame } from '../scripts/scroll';

  // Light and dark. The head script has already set the theme; this keeps
  // the button's label honest, saves a choice, and follows the system
  // setting live until the visitor makes one.
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  function label() {
    toggle?.setAttribute(
      'aria-label',
      root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
    );
  }

  function setTheme(theme: 'light' | 'dark') {
    const update = () => {
      root.dataset.theme = theme;
      if (themeColor) themeColor.content = theme === 'dark' ? '#171512' : '#ece6dc';
      label();
    };
    if (document.startViewTransition && !reduced.matches) document.startViewTransition(update);
    else update();
  }

  function saved() {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private browsing can refuse storage; the switch still works for this visit.
    }
    setTheme(next);
  });

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (!saved()) setTheme(event.matches ? 'dark' : 'light');
  });

  label();

  // The current section: the last one whose top has passed the middle of the
  // screen, checked in the page's one scroll loop.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.nav!))
    .filter((section): section is HTMLElement => section !== null);

  // Off the homepage there are no sections to follow; the page's own section stays lit.
  if (sections.length) onFrame(() => {
    let current = '';
    for (const section of sections) {
      if (section.getBoundingClientRect().top < innerHeight * 0.5) current = section.id;
    }
    return () => {
      for (const link of navLinks) link.classList.toggle('is-current', link.dataset.nav === current);
    };
  });
</script>

<style>
  .skip-link {
    position: fixed;
    top: 18px;
    left: 12px;
    z-index: 40;
    padding: 12px 20px;
    border-radius: var(--radius-pill);
    background: var(--fg);
    color: var(--bg);
    font-size: 14px;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .bar {
    position: fixed;
    top: 18px;
    left: 50%;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: min(700px, calc(100% - 24px));
    padding: 6px 6px 6px 22px;
    border: 1px solid var(--bar-border);
    border-radius: var(--radius-pill);
    background: var(--bar-bg);
    -webkit-backdrop-filter: blur(20px) saturate(1.3);
    backdrop-filter: blur(20px) saturate(1.3);
    box-shadow: inset 0 1px 0 var(--bar-hi);
    color: var(--fg);
    transform: translateX(-50%);
  }

  .wordmark {
    padding: 10px 0;
    font-size: 15px;
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: 0.2em;
    text-decoration: none;
    white-space: nowrap;
    /* Archivo's cap height (688 of 1000 units), measured from the font. The
       compact lockup is sized from it: mark height 2.2 caps, gap 0.8 caps. */
    --cap: 0.688em;
  }

  /* The mark sits on the text's baseline and is lowered so its waterline
     (43.3% down) lands on the middle of the capitals: half a cap above the
     baseline, minus the 56.7% of the mark that lies below the waterline.
     Negative block margins keep it from making the line (and the bar) taller;
     the bottom one moves its baseline up by a cap, so add a cap back. */
  .wordmark :global(.wordmark-mark) {
    width: calc(2.2 * 1.382 * var(--cap));
    height: calc(2.2 * var(--cap));
    margin: calc(-1 * var(--cap)) calc(0.8 * var(--cap)) calc(-1 * var(--cap)) 0;
    vertical-align: calc(0.5 * var(--cap) - 0.567 * 2.2 * var(--cap) + var(--cap));
  }

  nav {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 13px;
    border-radius: var(--radius-pill);
    font-size: 14px;
    text-decoration: none;
    opacity: 0.68;
    transition: opacity 200ms ease;
  }

  .nav-link:hover,
  .nav-link.is-current {
    opacity: 1;
  }

  .nav-link.say-hi {
    margin-left: 4px;
    padding: 0 18px;
    background: var(--fg);
    color: var(--bg);
    opacity: 1;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.68;
    transition: opacity 200ms ease;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  /* Phones: the middle two links hide, and the bar's left padding and gap
     tighten (and the wordmark's trailing tracking is taken back) so the
     lockup fits beside the controls at full size down to 390px. */
  @media (max-width: 760px) {
    .nav-mid {
      display: none;
    }

    .bar {
      gap: 6px;
      padding-left: 14px;
    }

    .wordmark {
      margin-right: -0.2em;
    }
  }
</style>
