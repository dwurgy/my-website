---
// The wordmark pill and the nav pill, floating over the hero photo.
// On phones the nav folds into a menu pill that opens it as a popover.
const links = [
  { href: '#work', label: 'Work' },
  { href: '#how', label: 'How I build' },
  { href: '#offclock', label: 'Off the clock' },
];
---

<header class="site-header">
  <a class="skip-link pill" href="#main">Skip to content</a>
  <a class="pill wordmark" href="/" aria-label="David Wurgler, home">WURGLER</a>
  <button class="pill menu-button" type="button" popovertarget="site-nav" aria-controls="site-nav">
    Menu
  </button>
  <nav class="pill nav" id="site-nav" popover aria-label="Main">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark mode">
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 10.5A6.5 6.5 0 0 1 7.5 3a6.5 6.5 0 1 0 7.5 7.5z"></path></svg>
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="9" cy="9" r="3.2"></circle><path d="M9 1.5v1.8M9 14.7v1.8M1.5 9h1.8M14.7 9h1.8M3.7 3.7l1.3 1.3M13 13l1.3 1.3M3.7 14.3L5 13M13 5l1.3-1.3"></path></svg>
    </button>
    <a class="nav-cta" href="#hello">Say hi</a>
  </nav>
</header>

<script>
  // Light and dark. The head script has already set the theme; this keeps
  // the button's label honest, saves a choice, and follows the system
  // setting live until the visitor makes one.
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  function label() {
    toggle?.setAttribute(
      'aria-label',
      root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
    );
  }

  function setTheme(theme: 'light' | 'dark') {
    const update = () => {
      root.dataset.theme = theme;
      if (themeColor) themeColor.content = theme === 'dark' ? '#171512' : '#ece6dc';
      label();
    };
    if (document.startViewTransition && !reduced.matches) document.startViewTransition(update);
    else update();
  }

  function saved() {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private browsing can refuse storage; the switch still works for this visit.
    }
    setTheme(next);
  });

  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
    if (!saved()) setTheme(event.matches ? 'dark' : 'light');
  });

  label();

  // Close the phone menu once a link in it is followed.
  const nav = document.getElementById('site-nav');
  nav?.addEventListener('click', (event) => {
    if (event.target instanceof HTMLAnchorElement && nav.matches(':popover-open')) {
      nav.hidePopover();
    }
  });
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 24px var(--gutter) 0;
  }

  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: 24px;
    z-index: 1;
    padding: 12px 20px;
    font-size: 14px;
    background: var(--bone);
    color: var(--ink);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  .wordmark {
    padding: 12px 30px;
    font-size: 22px;
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: 0.2em;
  }

  .menu-button {
    display: none;
    padding: 12px 20px;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  /* On wide screens the popover is shown in place as an ordinary pill. */
  .nav {
    position: static;
    inset: auto;
    margin: 0;
    display: flex;
    gap: 0;
    padding: 6px 8px;
    overflow: visible;
  }

  .nav a {
    padding: 10px 14px;
    font-size: 14px;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .nav a:not(.nav-cta):hover {
    background: rgb(255 255 255 / 0.14);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 200ms ease;
  }

  .theme-toggle:hover {
    opacity: 1;
  }

  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  .nav .nav-cta {
    padding: 10px 18px;
    background: var(--bone);
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .site-header {
      padding-top: 16px;
    }

    .wordmark {
      padding: 11px 22px;
      font-size: 17px;
    }

    .menu-button {
      display: inline-flex;
    }

    .nav:not(:popover-open) {
      display: none;
    }

    .nav:popover-open {
      position: fixed;
      inset: 76px var(--gutter) auto auto;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      min-width: 220px;
      padding: 8px;
      border-radius: var(--radius-card-small);
      background: rgb(40 34 30 / 0.55);
    }

    .nav:popover-open a {
      padding: 14px 18px;
      font-size: 17px;
    }

    .nav::backdrop {
      background: rgb(21 19 17 / 0.35);
    }
  }
</style>
