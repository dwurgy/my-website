---
// A reel of pictures, shown one at a time. Each keeps its own shape. The count
// and the words Back and Next sit above it, so they hold still while the
// picture changes shape. src/scripts/site.ts makes it move.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  shots: { src: ImageMetadata; alt: string; edge?: boolean }[];
}

const { shots } = Astro.props;
const many = shots.length > 1;
const ratio = (src: ImageMetadata) => `${src.width} / ${src.height}`;
---

<figure class="reel">
  {
    many && (
      <figcaption>
        <span aria-live="polite">1 / {shots.length}</span>
        <span class="ctl">
          <button type="button" data-dir="-1">Back</button>
          <button type="button" data-dir="1">Next</button>
        </span>
      </figcaption>
    )
  }
  <div class="frame" style={`aspect-ratio: ${ratio(shots[0].src)}`}>
    {
      shots.map((shot, i) => (
        <Image
          src={shot.src}
          alt={shot.alt}
          widths={[800, 1200, 1800, 2400]}
          sizes="(min-width: 820px) 61vw, 100vw"
          quality={86}
          class:list={[{ front: i === 0, edged: shot.edge }]}
          data-ratio={ratio(shot.src)}
          aria-hidden={i === 0 ? undefined : 'true'}
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>
</figure>
