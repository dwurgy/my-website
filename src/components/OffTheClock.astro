---
import Camera from './Camera.astro';

// Off the clock: the music, then the photographs, shown on the screen of a 3D
// camera that turns to face you as it scrolls into view. Normal page scroll;
// nothing here is pinned.
---

<section id="offclock" class="offclock" aria-labelledby="offclock-title">
  <div class="block">
    <h2 id="offclock-title" class="label eyebrow">Off the clock</h2>
    <p class="headline line">I sing, write, and produce.</p>
    <p class="body">
      My Brothers And I has songs placed on Virgin River, Pretty Little Liars, Queen Sugar, and others
      through Secret Road.
    </p>
    <div class="links">
      <a class="btn" href="https://open.spotify.com/artist/01pbsrLZgBLuMIoU10Ypyb">Spotify</a>
      <a class="btn" href="https://music.apple.com/us/artist/my-brothers-and-i/892386824">Apple Music</a>
    </div>
  </div>

  <div class="block photos">
    <h3 class="label eyebrow">Photographs</h3>
    <p class="headline line">I also take <span class="emphasis">pictures</span>.</p>
    <p class="body">
      I'm not a professional. I shoot the places I go and the light I find there. Flip through a few I
      like.
    </p>
  </div>

  <Camera />
</section>

<script>
  import { setPose } from '../scripts/camera';
  import { onFrame } from '../scripts/scroll';

  // The camera's pose follows scroll: 0 when its top enters the bottom of the
  // screen, 1 when its centre reaches the screen's centre. It turns back the
  // same way on the way up.
  const viewer = document.querySelector<HTMLElement>('#offclock [data-camera]')!;
  const stage = viewer.querySelector<HTMLElement>('.stage')!;

  onFrame(() => {
    const box = stage.getBoundingClientRect();
    const h = innerHeight;
    const p = (h - box.top) / (h / 2 + box.height / 2);
    return () => setPose(viewer, p);
  });
</script>

<style>
  .offclock {
    padding: 104px var(--gutter) 120px;
    display: flex;
    flex-direction: column;
    gap: 96px;
  }

  .block {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* The photographs' intro sits to the right on a wide screen, so the two
     blocks read as a pair, not a stack. */
  .photos {
    align-self: flex-end;
  }

  .eyebrow {
    margin: 0;
    font-weight: 400;
    color: var(--fg-muted);
  }

  .line {
    font-size: clamp(40px, 4.6vw, 68px);
    text-wrap: wrap;
  }

  .body {
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--body);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
  }

  @media (max-width: 760px) {
    .offclock {
      gap: 72px;
    }

    .photos {
      align-self: auto;
    }
  }
</style>
