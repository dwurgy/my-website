---
import { Image } from 'astro:assets';
import lodge from '../../assets/photos/lodge-dusk.jpg';
import pavilion from '../../assets/photos/pavilion-peak.jpg';
import firs from '../../assets/photos/firs-house.jpg';
import moon from '../../assets/photos/lake-dusk-moon.jpg';

const row = [
  { src: pavilion, alt: 'A timber pavilion framing a mountain peak beyond a pool.' },
  { src: firs, alt: 'Two old firs in front of a house and a dark car.' },
  { src: moon, alt: 'Mountains at dusk over still water, a sliver of moon above.' },
];
---

<section id="offclock" class="offclock" aria-labelledby="offclock-title">
  <div class="feature">
    <Image
      class="photo"
      src={lodge}
      alt="A glass-fronted lodge under tall pines at dusk."
      widths={[640, 960, 1280, 1920, 2560]}
      sizes="100vw"
    />
    <div class="scrim" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <div class="edge-labels">
      <h2 id="offclock-title" class="label">Off the clock</h2>
      <span class="label">Photographs, music</span>
    </div>

    <div class="band glass">
      <h3 class="label band-name">My Brothers And I</h3>
      <p class="band-line">
        I sing, write, and produce. Songs placed on Virgin River, Pretty Little Liars, Queen Sugar,
        and others through Secret Road.
      </p>
      <div class="band-links">
        <a class="pill" href="https://open.spotify.com/artist/01pbsrLZgBLuMIoU10Ypyb">Spotify</a>
        <a class="pill" href="https://music.apple.com/us/artist/my-brothers-and-i/892386824">Apple Music</a>
      </div>
    </div>
  </div>

  <div class="row">
    {
      row.map((photo) => (
        <Image
          class="row-photo"
          src={photo.src}
          alt={photo.alt}
          widths={[480, 720, 960, 1440]}
          sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw"
        />
      ))
    }
  </div>
</section>

<style>
  .feature {
    position: relative;
    height: clamp(560px, 60vw, 860px);
    /* clip, not hidden: hidden would make this the parallax's scroller. */
    overflow: clip;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Just enough shade to keep the edge labels and the card readable. */
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(20 16 14 / 0.3) 0%,
      rgb(20 16 14 / 0) 18%,
      rgb(20 16 14 / 0) 60%,
      rgb(20 16 14 / 0.35) 100%
    );
  }

  /* Slow parallax where the browser can tie it to scrolling; still otherwise. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .photo {
        inset: -10% 0;
        height: 120%;
        /* Longhands, because the minifier folds a shorthand plus timeline
           into one declaration that browsers reject. */
        animation-name: parallax;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
      }
    }
  }

  .feature .grain {
    --grain-photo-opacity: 0.35;
  }

  .edge-labels {
    position: absolute;
    top: var(--gutter);
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .edge-labels h2 {
    margin: 0;
    font-weight: 400;
  }

  .band {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    max-width: 610px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px 24px;
    border-radius: var(--radius-card-small);
  }

  .band-name {
    margin: 0;
    font-weight: 400;
    color: rgb(243 238 231 / 0.85);
  }

  .band-line {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
    color: var(--bone-bright);
  }

  .band-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
  }

  .band-links .pill {
    padding: 9px 16px;
    font-size: 13.5px;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding-top: 4px;
  }

  .row-photo {
    flex: 1 1 300px;
    min-width: 0;
    height: 420px;
    object-fit: cover;
  }

  /* The row drifts up into place as it enters, each photo a little further
     than the last, so they overlap on the way in. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .row-photo {
        animation-name: surface;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  /* The stagger only reads when the three sit side by side. */
  @media (min-width: 960px) {
    .row-photo:nth-child(2) {
      --surface-from: 72px;
    }

    .row-photo:nth-child(3) {
      --surface-from: 104px;
    }
  }

  @keyframes surface {
    from {
      opacity: 0.2;
      transform: translateY(var(--surface-from, 40px));
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 720px) {
    .band {
      padding: 18px 20px;
    }

    .band-line {
      font-size: 16px;
    }

    .row-photo {
      height: 300px;
    }
  }
</style>
