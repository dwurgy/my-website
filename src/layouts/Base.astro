---
import '../styles/site.css';
import averia from '@fontsource/averia-serif-libre/files/averia-serif-libre-latin-300-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** The page's own address, without the domain. */
  path: string;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const pageUrl = new URL(path, Astro.site).href;
// From the brand kit, used as it came.
const shareImage = new URL('/share-1200x630.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <!-- The card shown when a link is pasted into a message. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="David Wurgler" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="I make pretty things." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#eff0ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href={averia} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Lets the styles know scripts are running, before first paint.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <slot />
</html>
